FROM quay.io/centos/centos:stream10
RUN dnf install -y -q \
    bash \
    ca-certificates \
    curl \
    gcc \
    gcc-c++ \
    git \
    gnupg \
    jq \
    make \
    python3 \
    python3-pip \
    unzip \
    wget \
  && dnf clean all
# Enable CRB (CodeReady Builder) and EPEL for dev libraries on demand:
#   dnf install -y dnf-plugins-core
#   dnf config-manager --set-enabled crb
#   dnf install -y epel-release
WORKDIR /workspace
